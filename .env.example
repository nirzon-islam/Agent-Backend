# Copy these values into Render Environment. Never commit a real .env file.
NODE_ENV=production
PORT=3000
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster>/<database>?retryWrites=true&w=majority
ADMIN_USERNAME=<3-40 lowercase letters-numbers-underscore-or-hyphen>
ADMIN_PASSWORD=<8-128 character unique password; 12+ recommended>

# Dashboard AI keys are encrypted with AES-256-GCM. Generate 32 random bytes as 64 hex chars.
AI_SETTINGS_ENCRYPTION_KEY=<64-character-random-hex>

# Configure Main, Fallback, and Backup AI providers in the Owner Dashboard.

# Full GoatBot bridge. Set BRIDGE_ENABLED=true on Render only after setting a random 32+ character secret.
BRIDGE_ENABLED=false
BRIDGE_SECRET=<same-random-32-plus-character-secret-configured-as-AGENT_BRIDGE_SECRET-on-Railway>
AGENT_ALLOWED_SENDER_IDS=<comma-separated-approved-facebook-sender-ids>
WEBSITE_ORIGINS=<exact-dashboard-origin-if-hosted-on-a-separate-origin>

# Ed25519 private signing key for owner-approved OmegA-FCA licenses.
# Generate an Ed25519 key pair; keep the PRIVATE key only in Render secrets.
# Store the matching PUBLIC key in each approved FCA runtime.
FCA_LICENSE_PRIVATE_KEY=<PEM-private-key-with-newlines-escaped-as-\\n>
