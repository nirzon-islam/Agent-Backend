# Copy to your hosting provider's environment settings. Never commit a real .env file.
NODE_ENV=production
PORT=3000
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster>/<database>?retryWrites=true&w=majority
ADMIN_USERNAME=<3-40 lowercase letters-numbers-underscore-or-hyphen>
ADMIN_PASSWORD=<12-128 character unique password>

# Optional AI provider keys. Configure at least one supported provider before enabling AI planning.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=

# Keep bridge disabled until Messenger request intake, planner and approval workflow are implemented and tested.
BRIDGE_ENABLED=false
BRIDGE_SECRET=
WEBSITE_ORIGINS=
